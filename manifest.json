{
  "manifest_version": 3,
  "name": "MANGHO Detector",
  "version": "0.9.0",
  "description": "Helldivers 시리즈 갤러리 헬망호 모집을 감지하고 브라우저 오버레이로 알려주는 Chrome 확장 프로그램",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "*://gall.dcinside.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "MANGHO Detector"
  },
  "content_scripts": [
    {
      "matches": [
        "*://gall.dcinside.com/mgallery/board/lists*"
      ],
      "js": [
        "scripts/shared/seaf-domain.js",
        "scripts/shared/seaf-fetch.js",
        "scripts/shared/seaf-join-guard.js",
        "scripts/shared/seaf-overlay.js",
        "scripts/content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
